// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  EDITOR
}

enum Status {
  PUBLISHED
  DRAFT
}

// 1. ATUALIZADO: Modelo de Usuário com novos campos para a equipe
model User {
  id               String   @id @default(cuid())
  name             String?
  email            String   @unique
  password         String
  image            String?
  phone            String?
  role             Role     @default(EDITOR)
  
  jobDescription   String?  @db.Text // NOVO: Descrição da função
  showOnAboutPage  Boolean  @default(false) // NOVO: Controla a visibilidade na página "Sobre"
  personalQuote    String?  @db.Text // NOVO: Comentário/Citação pessoal

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 2. NOVO: Tabela para gerenciar configurações visuais de cada página
model PageSettings {
  id           String @id @default(cuid())
  pageKey      String @unique // Ex: "HOME", "ABOUT", "PORTFOLIO"
  heroImageUrl String?
}

// 3. NOVO: Tabela para o conteúdo específico da página "Sobre Nós"
model AboutPageContent {
  id           String   @id @default(cuid())
  title        String
  mainText     String   @db.Text
  mainImageUrl String?
  updatedAt    DateTime @updatedAt
}


// --- Modelos existentes ---
model HomePage {
  id             String @id @default(cuid())
  youtubeVideoId String
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  company   String
  image     String?
  quote     String
  highlight String?
  order     Int     @default(0)
}

model FaqItem {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text
  order    Int    @default(0)
}

model PortfolioItem {
  id               String   @id @default(cuid())
  title            String
  shortDescription String   @db.Text
  longDescription  String   @db.Text
  coverImage       String
  videoUrl         String?
  category         String
  status           Status   @default(DRAFT)
  isFeatured       Boolean  @default(false)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}