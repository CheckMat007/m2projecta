// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  EDITOR
}

enum Status {
  PUBLISHED
  DRAFT
}

// --- MODELOS DE NOTIFICAÇÃO ---
model Notification {
  id           String                   @id @default(cuid())
  title        String
  message      String                   @db.Text
  createdAt    DateTime                 @default(now())
  isBroadcast  Boolean                  @default(false)
  senderId     String?
  sender       User?                    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  readStatuses UserNotificationStatus[]
}

model UserNotificationStatus {
  id             String       @id @default(cuid())
  isRead         Boolean      @default(false)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
}

// --- MODELO DE USUÁRIO ---
model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  password           String
  image              String?
  phone              String?
  role               Role      @default(EDITOR)
  jobDescription     String?   @db.Text
  showOnAboutPage    Boolean   @default(false)
  personalQuote      String?   @db.Text
  mustChangePassword Boolean   @default(true)
  
  notifications      UserNotificationStatus[]
  sentNotifications  Notification[]           @relation("SentNotifications")
  permissions        Permission[]
  
  authoredPosts      Post[]                   @relation("AuthoredPosts")
  editedPosts        Post[]                   @relation("EditedPosts")
  
  votes              PostVote[]
  comments           Comment[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// --- MODELOS DE CONTEÚDO DO SITE ---
model Permission {
  id          String @id @default(cuid())
  name        String @unique
  description String
  users       User[]
}

model PageSettings {
  id           String  @id @default(cuid())
  pageKey      String  @unique
  heroImageUrl String?
}

model AboutPageContent {
  id           String   @id @default(cuid())
  title        String
  mainText     String   @db.Text
  mainImageUrl String?
  updatedAt    DateTime @updatedAt
}

model HomePage {
  id             String @id @default(cuid())
  youtubeVideoId String
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  company   String
  image     String?
  quote     String
  highlight String?
  order     Int     @default(0)
}

model FaqItem {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text
  order    Int    @default(0)
}

model Service {
  id               String        @id @default(cuid())
  name             String        @unique
  shortDescription String        @db.Text
  longDescription  String        @db.Text
  icon             String
  image            String
  videoUrl         String?
  portfolioItems   PortfolioItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model PortfolioItem {
  id               String   @id @default(cuid())
  title            String
  shortDescription String   @db.Text
  longDescription  String   @db.Text
  coverImage       String
  videoUrl         String?
  status           Status   @default(DRAFT)
  isFeatured       Boolean  @default(false)
  seoTitle         String?
  seoDescription   String?
  serviceId        String?
  service          Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// --- MODELOS DO BLOG ---
model Post {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  title                String
  content              String    @db.Text
  featuredImageUrl     String?
  featuredImageAlt     String?
  featuredImageSource  String?
  status               Status    @default(DRAFT)
  seoTitle             String?
  seoDescription       String?
  estimatedReadingTime Int?
  isFeatured           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  authorId             String
  author               User      @relation("AuthoredPosts", fields: [authorId], references: [id], onDelete: Cascade)
  lastEditorId         String?
  lastEditor           User?     @relation("EditedPosts", fields: [lastEditorId], references: [id], onDelete: SetNull)
  categories           Category[]
  tags                 Tag[]
  votes                PostVote[]
  comments             Comment[]
}

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String @unique
  posts Post[]
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String @unique
  posts Post[]
}

// --- MODELOS DE ENGAJAMENTO ---
enum VoteType {
  LIKE
  DISLIKE
}

model PostVote {
  id     String   @id @default(cuid())
  type   VoteType
  
  postId String
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  // Alterações para Votação Anônima
  userId String?  // 1. Tornamos o userId opcional
  user   User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  voterId String? @db.Uuid // 2. Adicionamos o identificador anônimo
  
  // 3. Adicionamos um índice para melhorar a performance da busca por votos anônimos
  @@index([voterId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String   @db.Text
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
}