// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  EDITOR
}

enum Status {
  PUBLISHED
  DRAFT
}

// 1. NOVO MODELO PARA NOTIFICAÇÕES
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  createdAt DateTime @default(now())

  // NOVO: Relação para saber quem enviou a notificação
  senderId  String?
  sender    User?    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)

  // Relação existente: Um status de leitura por usuário que recebe
  readStatuses UserNotificationStatus[]
}

// 2. NOVO MODELO PARA RASTREAR A LEITURA DE NOTIFICAÇÕES
// Tabela de junção entre User e Notification
model UserNotificationStatus {
  id             String       @id @default(cuid())
  isRead         Boolean      @default(false)
  
  // Relações
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId]) // Garante que um usuário só tenha um status por notificação
}


model User {
  id               String   @id @default(cuid())
  name             String?
  email            String   @unique
  password         String
  image            String?
  phone            String?
  role             Role     @default(EDITOR)
  
  jobDescription   String?  @db.Text
  showOnAboutPage  Boolean  @default(false)
  personalQuote    String?  @db.Text
  
  // 3. NOVO CAMPO PARA FORÇAR A TROCA DE SENHA
  mustChangePassword Boolean @default(true)

  // Relação: Um usuário pode ter vários status de notificação
  notifications UserNotificationStatus[]
  sentNotifications  Notification[] @relation("SentNotifications")
  permissions      Permission[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// --- Modelos existentes (sem alterações) ---

model Permission {
  id          String @id @default(cuid())
  name        String @unique
  description String
  users       User[]
}

model PageSettings {
  id           String @id @default(cuid())
  pageKey      String @unique
  heroImageUrl String?
}

model AboutPageContent {
  id           String   @id @default(cuid())
  title        String
  mainText     String   @db.Text
  mainImageUrl String?
  updatedAt    DateTime @updatedAt
}

model HomePage {
  id             String @id @default(cuid())
  youtubeVideoId String
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  company   String
  image     String?
  quote     String
  highlight String?
  order     Int     @default(0)
}

model FaqItem {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text
  order    Int    @default(0)
}

model Service {
  id               String   @id @default(cuid())
  name             String   @unique
  shortDescription String   @db.Text
  longDescription  String   @db.Text
  icon             String
  image            String
  videoUrl         String?
  portfolioItems   PortfolioItem[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PortfolioItem {
  id               String   @id @default(cuid())
  title            String
  shortDescription String   @db.Text
  longDescription  String   @db.Text
  coverImage       String
  videoUrl         String?
  status           Status   @default(DRAFT)
  isFeatured       Boolean  @default(false)
  seoTitle         String?
  seoDescription   String?
  serviceId        String?
  service          Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull) // Alterado para SetNull
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}