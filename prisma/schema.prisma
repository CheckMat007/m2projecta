// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelos de Enumeração
enum Role {
  MASTER
  EDITOR
}

enum Status {
  PUBLISHED
  DRAFT
}

// Modelos de Tabela

model User {
  id               String   @id @default(cuid())
  name             String?
  email            String   @unique
  password         String
  image            String?
  phone            String?
  role             Role     @default(EDITOR)
  jobDescription   String?  @db.Text
  showOnAboutPage  Boolean  @default(false)
  personalQuote    String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PageSettings {
  id           String @id @default(cuid())
  pageKey      String @unique
  heroImageUrl String?
}

model AboutPageContent {
  id           String   @id @default(cuid())
  title        String
  mainText     String   @db.Text
  mainImageUrl String?
  updatedAt    DateTime @updatedAt
}

model HomePage {
  id             String @id @default(cuid())
  youtubeVideoId String
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  company   String
  image     String?
  quote     String
  highlight String?
  order     Int     @default(0)
}

model FaqItem {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text
  order    Int    @default(0)
}

// NOVO MODELO PARA SERVIÇOS
model Service {
  id               String   @id @default(cuid())
  name             String   @unique
  shortDescription String   @db.Text
  longDescription  String   @db.Text
  icon             String
  image            String
  videoUrl         String?

  // Relação: Um serviço pode ter vários itens de portfólio
  portfolioItems PortfolioItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// MODELO DE PORTFÓLIO ATUALIZADO
model PortfolioItem {
  id               String   @id @default(cuid())
  title            String
  shortDescription String   @db.Text
  longDescription  String   @db.Text
  coverImage       String
  videoUrl         String?
  status           Status   @default(DRAFT)
  isFeatured       Boolean  @default(false)
  seoTitle         String?
  seoDescription   String?
  
  // NOVA RELAÇÃO: Um item de portfólio pertence a UM serviço
  serviceId        String?
  service          Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}